# Copy to `.env` and set your real Cloudinary API secret (never commit `.env`).
# If `.env` is missing, the server still reads this file for local development.
#
# --- Server (Express / serverless functions) ---
PORT=3001

# file       -> store data in server/data/db.json (works locally / on hosts with a disk)
# cloudinary -> store data as a raw asset in Cloudinary (persists on serverless hosts)
STORAGE_DRIVER=file

# Optional: override the JSON data file location
# DATA_FILE=./server/data/db.json

# CORS origin for the API (use your deployed frontend URL in production)
CORS_ORIGIN=*

# --- Cloudinary (photo uploads + optional JSON database) ---
CLOUDINARY_CLOUD_NAME=qm0d1wsi
CLOUDINARY_API_KEY=946526996645857
CLOUDINARY_API_SECRET=lhm2nmHu0hX-uj63q4QvrRcPpXk
CLOUDINARY_FOLDER=movemate

# Max upload size in bytes (default 8MB)
# MAX_UPLOAD_BYTES=8388608
