{
  "name": "movemate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "client/server"
  ],
  "scripts": {
    "setup": "cp -n client/server/.env.example client/server/.env 2>/dev/null || true; cp -n client/.env.example client/.env 2>/dev/null || true",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix client/server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "typecheck": "npm --prefix client/server run typecheck && npm --prefix client run build",
    "start": "npm --prefix client/server run start",
    "lint": "npm --prefix client run lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
