{
  "name": "movemate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup": "cp -n server/.env.example server/.env 2>/dev/null || true; cp -n client/.env.example client/.env 2>/dev/null || true",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run build -w client",
    "start": "npm run start -w server",
    "lint": "npm run lint -w client"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
